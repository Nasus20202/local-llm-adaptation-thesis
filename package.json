{
  "name": "thesis-bench-verification-tools",
  "private": true,
  "description": "Pinned Node.js tools used by routine repository verification.",
  "devDependencies": {
    "@fission-ai/openspec": "1.11.0",
    "prettier": "3.9.6",
    "renovate": "44.56.1"
  },
  "scripts": {
    "format": "prettier --ignore-path=.prettierignore --write \"data/benchmark/development/model-facing/*.json\"",
    "format:check": "prettier --ignore-path=.prettierignore --check \"data/benchmark/development/model-facing/*.json\""
  }
}
