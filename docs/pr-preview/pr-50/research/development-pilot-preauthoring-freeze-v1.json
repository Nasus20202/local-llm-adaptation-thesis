      "expected result",
      "golden answer",
      "answer-revealing evidence map",
      "answer-revealing rubric anchor or decision",
      "adjudication prose that reveals an answer",
      "protected payload excerpt",
      "recovery data for redacted material",
      "absolute protected locator",
      "final-test locator or reference"
    ],
    "marker_rule": "replace answer-revealing excerpts with a non-recoverable protected-redaction marker; retain the full record only in the protected evaluator root",
    "validation_error_rule": "emit identifiers, status/reason codes, and hashes only; never copy protected payloads into errors or logs"
  },
