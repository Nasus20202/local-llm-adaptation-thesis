        "parse-or-schema",
        "prohibited-action",
        "required-constraint",
        "static-or-final-state-when-applicable"
      ],
      "supporting_metric_classes": [
        "constraint-adherence",
        "step-errors",
        "schema-validity"
      ]
    }
