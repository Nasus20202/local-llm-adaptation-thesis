        "artifact-or-state-success",
        "evidence-or-citation"
      ],
      "supporting_metric_classes": [
        "knowledge-correctness",
        "procedural-success",
        "cost"
      ]
    },
    "procedural": {
      "answer_form_class": "yaml-json-patch-bounded-action-sequence-or-structured-diagnosis",
